;
; SNKernelDriver.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ManufacturerName%
CatalogFile = SNKernelDriver.cat
DriverVer   = 10/24/2025,1.0.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 12  ; Drivers directory (%SystemRoot%\System32\Drivers)

[SourceDisksNames]
1 = %DiskName%,,, 

[SourceDisksFiles]
SNKernelDriver.sys = 1,, 

;*****************************************
; Manufacturer Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$

[Standard.NT$ARCH$]
%SNKernelDriver.DeviceDesc% = SNKernelDriver_Device, Root\SNKernelDriver

;*****************************************
; Installation Section
;*****************************************

[SNKernelDriver_Device.NT]
CopyFiles = SNKernelDriver_CopyFiles
AddReg    = SNKernelDriver_AddReg

[SNKernelDriver_CopyFiles]
SNKernelDriver.sys

[SNKernelDriver_AddReg]
HKR,"Parameters","Extensions",0x00010000,"exe","doc","txt","bat","cmd","inf"

;*****************************************
; Service Installation
;*****************************************

[SNKernelDriver_Device.NT.Services]
AddService = SNKernelDriver, %SPSVCINST_ASSOCSERVICE%, SNKernelDriver_Service_Inst

[SNKernelDriver_Service_Inst]
DisplayName    = %SNKernelDriver.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\SNKernelDriver.sys
LoadOrderGroup = "FSFilter Content Screener"
Dependencies   = "FltMgr"



;*****************************************
; WDF Section (for KMDF drivers)
;*****************************************

[SNKernelDriver_Device.NT.Wdf]
KmdfService = SNKernelDriver, SNKernelDriver_wdfsect

[SNKernelDriver_wdfsect]
KmdfLibraryVersion = 1.33

;*****************************************
; String Definitions
;*****************************************

[Strings]
SPSVCINST_ASSOCSERVICE   = 0x00000002
ManufacturerName         = "Your Company Name"
DiskName                 = "SNKernelDriver Installation Disk"
SNKernelDriver.DeviceDesc = "SNKernelDriver Device"
SNKernelDriver.SVCDESC    = "SNKernelDriver Service"
