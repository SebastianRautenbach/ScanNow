;
; SNKernelDriver.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System ; TODO: specify appropriate Class
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider    = %ManufacturerName%
CatalogFile = SNKernelDriver.cat
DriverVer   = ; TODO: set DriverVer in stampinf property pages
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
SNKernelDriver.sys = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299 ; %13% support introduced in build 16299

[Standard.NT$ARCH$.10.0...16299]
%SNKernelDriver.DeviceDesc% = SNKernelDriver_Device, Root\SNKernelDriver ; TODO: edit hw-id

[SNKernelDriver_Device.NT]
CopyFiles = File_Copy

[File_Copy]
SNKernelDriver.sys

;-------------- Service installation
[SNKernelDriver_Device.NT.Services]
AddService = SNKernelDriver,%SPSVCINST_ASSOCSERVICE%, SNKernelDriver_Service_Inst


;-------------- Registry values
[Common.AddRegistry]
HKR,"Parameters","Extensions",0x00010000,"exe","doc","txt","bat","cmd","inf"


; -------------- SNKernelDriver driver install sections
[SNKernelDriver_Service_Inst]
DisplayName    = %SNKernelDriver.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\SNKernelDriver.sys

[SNKernelDriver_Device.NT.Wdf]
KmdfService = SNKernelDriver, SNKernelDriver_wdfsect

[SNKernelDriver_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "SNKernelDriver Installation Disk"
SNKernelDriver.DeviceDesc = "SNKernelDriver Device"
SNKernelDriver.SVCDESC = "SNKernelDriver Service"
